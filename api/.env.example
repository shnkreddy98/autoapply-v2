# --- database (shared root compose) ---
DB_HOST=localhost
DB_PORT=15432
DB_NAME=jobs-db
DB_USER=admin
DB_PASSWORD=password
# RLS-bound role the API uses for all user-facing queries (created by db/init.sql;
# change in prod with: ALTER ROLE autoapply_api PASSWORD '...')
AUTOAPPLY_API_PASSWORD=autoapply_api_dev

# --- Google Sign-In (Web application OAuth client) ---
# Register <API_BASE_URL>/auth/google/callback as an authorized redirect URI.
# Falls back to GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET if unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL used to build the OAuth redirect (default: request host)
#API_BASE_URL=http://localhost:8000
# Set to 0 for plain-http dev so the session cookie is sent
API_COOKIE_SECURE=0

# --- object storage (tailored-resume presigned links) ---
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=autoapply
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- secrets at rest (gmail refresh tokens; see common/common/crypto.py) ---
AUTOAPPLY_ENC_KEY=
