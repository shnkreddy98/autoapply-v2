# Bearer-token gate in front of Ollama. Plain HTTP on :11434 — RunPod's proxy
# terminates TLS (https://<pod-id>-11434.proxy.runpod.net).
{
	auto_https off
	admin off
}

:11434 {
	@authed header Authorization "Bearer {$PROXY_TOKEN}"

	handle @authed {
		reverse_proxy 127.0.0.1:11435 {
			# ollama 403s any Host it doesn't consider local (rebinding
			# protection) — present ourselves as the loopback upstream
			header_up Host {upstream_hostport}
		}
	}

	handle {
		respond "unauthorized" 401
	}
}
