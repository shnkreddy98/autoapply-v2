# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Any OpenAI-compatible endpoint. Default: OpenRouter. For a local Ollama
# (see ../open-model/): OPENROUTER_BASE_URL=http://localhost:11434/v1,
# OPENROUTER_MODEL=qwen3:4b, OPENROUTER_API_KEY=ollama (any non-empty value).
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional
OPENROUTER_APP_NAME=auto-browse

# Login the agent uses for job portals that require sign-in / account creation.
# Env for now; will move to the DB later. Login email defaults to APPLICANT_EMAIL.
APPLICANT_LOGIN_EMAIL=
APPLICANT_LOGIN_PASSWORD=

# App-level Google OAuth client for the Gmail 2FA tool (GCP Console -> APIs &
# Services -> Credentials -> OAuth client ID, type "Desktop app"; enable the Gmail
# API). Per-user grants are then created with: uv run autoapply gmail connect
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Push alerts when a run needs a person (captcha, a code not in the inbox): ntfy topic
# the phone app subscribes to (agent/notify.py). Pick something unguessable; anyone
# with the topic can read the alerts (job URL + reason, never codes or passwords).
NTFY_TOPIC=
# what tapping an alert opens: this machine's noVNC on the LAN / Tailscale address
NOTIFY_VNC_URL=http://localhost:6080/vnc.html
# the agent resumes by itself once the step is gone from the page; gives up after this
HANDOFF_TIMEOUT_SECONDS=1800

# Symmetric key encrypting secrets at rest in Postgres (Gmail refresh tokens).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it = every user must re-run `autoapply gmail connect`. Keep out of the DB.
AUTOAPPLY_ENC_KEY=
