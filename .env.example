# Shared infra config for autoapply-v2. Copy to .env (root) and per-service as needed.
# All three services (search, auto-browse, ai-assist) + common read these.

# --- Postgres (root compose) ---
DB_HOST=localhost
DB_PORT=25432
DB_NAME=jobs-db
DB_USER=admin
DB_PASSWORD=password

# --- Object storage ---
# STORAGE_BACKEND=s3 uses MinIO/S3 below; =local uses STORAGE_LOCAL_ROOT (dev/tests only).
STORAGE_BACKEND=s3
S3_BUCKET=autoapply
S3_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# STORAGE_LOCAL_ROOT=./.storage

# --- MinIO host port mapping (root compose) ---
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- Workers ---
# auto-browse apply loop / JD-capture reach the proxy MCP here:
PROXY_MCP_URL=http://localhost:8932/mcp
# host dir staged resumes are downloaded to, mounted into the playwright container:
SCRATCH_ROOT=./data/runs
RESUME_CONTAINER_ROOT=/work/runs

# --- LLM (ai-assist tailor + auto-browse loop) ---
OPENROUTER_API_KEY=
# RUN_LLM_E2E=1   # opt-in: run the real-LLM tailoring test
